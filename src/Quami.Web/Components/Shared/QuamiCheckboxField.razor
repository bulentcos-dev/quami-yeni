@* Onay kutusu. Etiket kutunun sağındadır. *@
<div class="quami-field quami-field--check @Class">
    <label class="quami-check">
        <InputCheckbox id="@_id" Value="@Value" ValueChanged="@ValueChanged"
                       ValueExpression="@ValueExpression" disabled="@Disabled" />
        <span>@Label</span>
    </label>

    @if (EditContext is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="quami-validation" />
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="quami-hint">@Hint</div>
    }
</div>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
}

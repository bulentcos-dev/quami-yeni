@typeparam TValue
@* Tarih alanı. DateTime, DateOnly ve nullable karşılıkları.
   Tarih+saat için Type="InputDateType.DateTimeLocal" verin. *@
<QuamiFieldShell Label="@Label" For="@_id" Hint="@Hint" Required="@Required" Class="@Class">
    <ChildContent>
        <InputDate id="@_id" class="quami-input" TValue="TValue" Type="@Type"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   disabled="@Disabled" min="@Min" max="@Max" />
    </ChildContent>
    <Validation>
        @if (EditContext is not null && ValueExpression is not null)
        {
            <ValidationMessage For="@ValueExpression" class="quami-validation" />
        }
    </Validation>
</QuamiFieldShell>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter] public InputDateType Type { get; set; } = InputDateType.Date;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string? Class { get; set; }
}

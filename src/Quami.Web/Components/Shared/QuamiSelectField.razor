@typeparam TValue
@inject IStringLocalizer<SharedResource> L
@* Açılır liste. Seçenekler Options ile verilir. *@
<QuamiFieldShell Label="@Label" For="@_id" Hint="@Hint" Required="@Required" Class="@Class">
    <ChildContent>
        <InputSelect id="@_id" class="quami-input quami-select" TValue="TValue"
                     Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                     disabled="@Disabled">
            @if (ShowEmptyOption)
            {
                <option value="">@(EmptyText ?? L["Common.Select"].Value)</option>
            }
            @foreach (var option in Options)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </InputSelect>
    </ChildContent>
    <Validation>
        @if (EditContext is not null && ValueExpression is not null)
        {
            <ValidationMessage For="@ValueExpression" class="quami-validation" />
        }
    </Validation>
</QuamiFieldShell>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<QuamiOption<TValue>> Options { get; set; } = [];

    [Parameter] public bool ShowEmptyOption { get; set; } = true;
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
}

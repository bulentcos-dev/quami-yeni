@* Standart buton. Üç tür: birincil (turuncu vurgu), ikincil (çerçeveli),
   tehlikeli (silme vb.). Modül içinde buton stili yazılmaz, bu kullanılır. *@
<button type="@(Submit ? "submit" : "button")"
        class="quami-btn quami-btn--@Variant.ToString().ToLowerInvariant() @Class"
        disabled="@(Disabled || Busy)"
        title="@Title"
        @onclick="OnClick"
        @attributes="Extra">
    @if (Busy)
    {
        <span class="quami-btn-spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrWhiteSpace(Icon))
    {
        <QuamiIcon Name="@Icon" Size="16" />
    }
    @ChildContent
</button>

@code {
    public enum ButtonVariant { Primary, Secondary, Danger }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Lucide ikon adı (isteğe bağlı).</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>true ise form gönderim butonu olur.</summary>
    [Parameter] public bool Submit { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>İşlem sürüyor: buton kilitlenir ve dönen gösterge çıkar.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }
}

@typeparam TValue
@* Sayı alanı. int, long, decimal, double ve bunların nullable karşılıkları. *@
<QuamiFieldShell Label="@Label" For="@_id" Hint="@Hint" Required="@Required" Class="@Class">
    <ChildContent>
        <InputNumber id="@_id" class="quami-input" TValue="TValue"
                     Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                     placeholder="@Placeholder" disabled="@Disabled" step="@Step" />
    </ChildContent>
    <Validation>
        @if (EditContext is not null && ValueExpression is not null)
        {
            <ValidationMessage For="@ValueExpression" class="quami-validation" />
        }
    </Validation>
</QuamiFieldShell>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Ondalık alanlarda "0.01" gibi bir adım verin.</summary>
    [Parameter] public string? Step { get; set; }

    [Parameter] public string? Class { get; set; }
}

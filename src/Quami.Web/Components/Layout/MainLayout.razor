@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<div class="quami-shell">
    <aside class="quami-sidebar">
        <div class="quami-brand">Qu<span>a</span>mi</div>
        <NavMenu />
    </aside>

    <div class="quami-main">
        <header class="quami-topbar">
            <LanguageSwitcher />
            <AuthorizeView>
                <Authorized>
                    <span class="quami-user">@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
            <a href="/logout">@L["TopBar.SignOut"]</a>
        </header>

        <main class="quami-content">
            @* Lisans kontrolü sunucuda burada yapılır: lisanssız modülün
               sayfası hiç oluşturulmaz, adres elle yazılsa bile. *@
            <ModuleAccessGuard>
                @Body
            </ModuleAccessGuard>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

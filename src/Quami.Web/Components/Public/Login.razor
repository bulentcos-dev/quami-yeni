@page "/login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Endpoints
@using Quami.Application.Abstractions
@attribute [AllowAnonymous]
@* Statik render zorunlu: oturum çerezi yalnızca HTTP yanıtında yazılabilir,
   etkileşimli devre içinde yazılamaz. *@
@attribute [ExcludeFromInteractiveRouting]
@layout Quami.Web.Components.Layout.BareLayout
@inject IAuthenticationProvider AuthenticationProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login.Title"] — @L["App.Name"]</PageTitle>

<h1>Qu<span>a</span>mi</h1>

<EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync">
    @if (_message is not null)
    {
        <p class="quami-alert" role="alert">@_message</p>
    }

    <div class="quami-field">
        <label for="tenant">@L["Login.TenantCode"]</label>
        <InputText id="tenant" @bind-Value="Input.TenantShortName" autocomplete="organization" />
    </div>
    <div class="quami-field">
        <label for="user">@L["Login.UserName"]</label>
        <InputText id="user" @bind-Value="Input.UserName" autocomplete="username" />
    </div>
    <div class="quami-field">
        <label for="pass">@L["Login.Password"]</label>
        <InputText id="pass" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
    </div>
    <div class="quami-field">
        <label>
            <InputCheckbox @bind-Value="Input.RememberMe" /> @L["Login.RememberMe"]
        </label>
    </div>

    <button type="submit" class="quami-button">@L["Login.Submit"]</button>
</EditForm>

@code {
    private string? _message;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    // Form gönderiminde null gelebildiği için başlangıç değeri burada verilir.
    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private async Task SignInAsync()
    {
        // Zorunlu alan kontrolü kodda yapılır; metinler yine kaynak dosyasından gelir.
        _message = FirstMissingFieldMessage();
        if (_message is not null)
            return;

        var status = await AuthenticationProvider.SignInWithPasswordAsync(
            Input.TenantShortName, Input.UserName, Input.Password, Input.RememberMe);

        if (status == SignInStatus.Success)
        {
            // forceLoad: çerez yeni yazıldı, tam sayfa yüklemesi gerekiyor.
            Navigation.NavigateTo(SafeReturnUrl(), forceLoad: true);
            return;
        }

        _message = status switch
        {
            // Kurum yok / kullanıcı yok / parola yanlış: ÜÇÜ DE aynı mesaj.
            // Ayrım yalnızca kimlik olay günlüğünde tutulur.
            SignInStatus.InvalidCredentials => L["Login.Error.InvalidCredentials"],
            SignInStatus.LockedOut => L["Login.Error.LockedOut"],
            SignInStatus.NotAllowed => L["Login.Error.NotAllowed"],
            SignInStatus.RequiresTwoFactor => L["Login.Error.TwoFactor"],
            _ => L["Login.Error.Generic"]
        };
    }

    private string? FirstMissingFieldMessage()
    {
        if (string.IsNullOrWhiteSpace(Input.TenantShortName)) return L["Login.Validation.TenantRequired"];
        if (string.IsNullOrWhiteSpace(Input.UserName)) return L["Login.Validation.UserNameRequired"];
        if (string.IsNullOrWhiteSpace(Input.Password)) return L["Login.Validation.PasswordRequired"];
        return null;
    }

    /// <summary>Açık yönlendirme (open redirect) koruması: yalnızca site içi adresler.</summary>
    private string SafeReturnUrl()
    {
        var url = ReturnUrl;
        if (string.IsNullOrWhiteSpace(url)) return "/";
        if (!url.StartsWith('/') || url.StartsWith("//") || url.StartsWith("/\\")) return "/";
        return url;
    }

    private sealed class LoginInput
    {
        public string TenantShortName { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}

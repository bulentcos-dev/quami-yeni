@page "/not-found"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout Quami.Web.Components.Layout.BareLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFound.Title"] — @L["App.Name"]</PageTitle>

<h1>@L["NotFound.Title"]</h1>
<p class="quami-muted">@L["NotFound.Message"]</p>
<p><a href="/">@L["Home.Title"]</a></p>

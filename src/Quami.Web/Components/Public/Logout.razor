@page "/logout"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Endpoints
@using Quami.Application.Abstractions
@attribute [AllowAnonymous]
@* Statik render zorunlu: oturum çerezi HTTP yanıtında silinir. *@
@attribute [ExcludeFromInteractiveRouting]
@layout Quami.Web.Components.Layout.BareLayout
@inject IAuthenticationProvider AuthenticationProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Logout.Title"] — @L["App.Name"]</PageTitle>

<h1>Qu<span>a</span>mi</h1>

@* Çıkış POST ile yapılır: GET bağlantısı başka sitelerden tetiklenebilirdi. *@
<EditForm Model="this" FormName="logout" OnValidSubmit="SignOutAsync">
    <p>@L["Logout.Question"]</p>
    <button type="submit" class="quami-button">@L["Logout.Submit"]</button>
</EditForm>

@code {
    private async Task SignOutAsync()
    {
        await AuthenticationProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
